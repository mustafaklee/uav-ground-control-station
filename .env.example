# Copy to .env and change the values. .env is git-ignored.
POSTGRES_USER=gcs
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=gcs
RABBITMQ_USER=gcs
RABBITMQ_PASSWORD=change-me-rabbitmq

# JWT signing key, at least 32 bytes. Generate one: openssl rand -base64 48
JWT_SIGNING_KEY=
# First administrator, created only while the user table is empty (at least 12 characters).
GCS_ADMIN_USERNAME=admin
GCS_ADMIN_PASSWORD=
