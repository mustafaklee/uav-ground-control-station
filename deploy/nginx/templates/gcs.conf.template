# Rendered at container start: ${GCS_DOMAIN} is replaced (only GCS_* variables are; $host and friends stay Nginx's).

# Any name other than ours (scanners trying the bare IP, a wrong Host): refuse the TLS handshake itself, without
# showing them our certificate or anything behind it.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${GCS_DOMAIN};

    # ---- TLS ---------------------------------------------------------------------------------------------------
    # Written by install.sh: Let's Encrypt (renewed by certbot) or the internal CA. Reloaded with nginx -s reload.
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    # TLS 1.2 and 1.3 only (Mozilla "intermediate"): 1.0/1.1 are broken and disabled in every current client.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:GCS_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Clients must use HTTPS for two years. Set here, once, for every response (the API's own copy is dropped below).
    add_header Strict-Transport-Security "max-age=63072000" always;
    proxy_hide_header Strict-Transport-Security;

    client_max_body_size 1m;  # the largest request is a mission upload, a few kilobytes
    limit_conn gcs_conn 50;   # open connections per client address

    # ---- What every proxied request carries ---------------------------------------------------------------------
    # X-Forwarded-For is set to the address Nginx sees, not appended to: whatever the client put there is discarded,
    # so nobody can claim another address. The API trusts these headers only from this proxy's network.
    proxy_set_header Host               $host;
    proxy_set_header X-Forwarded-For    $remote_addr;
    proxy_set_header X-Forwarded-Proto  https;
    proxy_set_header X-Correlation-ID   $gcs_correlation_id;
    proxy_http_version 1.1;           # needed for upstream keepalive and for WebSocket
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;

    # Sign-in and token refresh: the strictest limit (password guessing).
    location /api/v1/auth/ {
        limit_req zone=gcs_auth burst=5 nodelay;
        proxy_pass http://gcs_api;
    }

    # SignalR. The client first negotiates over HTTP, then upgrades to a WebSocket that stays open for the whole
    # session. A long read timeout keeps idle-but-alive sockets (SignalR pings every 15 s), and buffering is off so
    # each telemetry message goes out the moment the API writes it.
    location /hubs/ {
        proxy_pass http://gcs_api;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Liveness and readiness for load balancers and uptime checks; no rate limit, like in the API.
    location /health/ {
        proxy_pass http://gcs_api;
    }

    location / {
        limit_req zone=gcs_api burst=40 nodelay;
        proxy_pass http://gcs_api;
    }
}

# Plain HTTP on the loopback interface, for the container's own health check only (not published).
server {
    listen 127.0.0.1:8081;
    access_log off;

    location = /health/live {
        proxy_pass http://gcs_api;
        proxy_set_header Host localhost;
    }
}
