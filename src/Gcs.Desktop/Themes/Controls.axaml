<!--
  Control styles on top of the Fluent theme (ADR-020). Fluent supplies behaviour, keyboard handling and templates; this
  file supplies the look, using only tokens from Tokens.axaml. Class names are the vocabulary the views use:

    Buttons      (default) secondary · primary · danger · warning · ghost · icon · large
    Text         h1 · h2 · overline · caption · muted · tertiary · mono · value · value-lg · display
    Containers   Border.section · Border.toolbar · Border.badge(.success .warning .danger .info .neutral .accent)
                 Border.alert(.danger .warning .info .success), its icon StrokeIcon.lead · Border.tile · Rectangle.divider · Ellipse.dot
    Navigation   RadioButton.nav
    Lists        ListBox.rows

  Motion: none apart from Fluent's own pressed scale. State changes are instant, which also respects operators who
  turned animations off in the operating system.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Gcs.Desktop.Controls">

  <!-- Windows and text -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Overline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Value}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.value-lg">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Headline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <!-- Buttons: secondary by default -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
    <Setter Property="Padding" Value="{StaticResource Space.ControlPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface.2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
  </Style>

  <!-- A toggle that is on: blue, the selection colour -->
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <!-- Primary: the one main action of an area (amber) -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Foreground}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Pressed}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Foreground}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Subtle}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
  </Style>

  <!-- Danger: actions with consequences that cannot be taken back (arm, confirmations) -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Hover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger.Hover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Pressed}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger.Pressed}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger.Subtle}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
  </Style>

  <!-- Warning: flight-safety actions that end a flight (land, return to launch): outlined, so they read as distinct -->
  <Style Selector="Button.warning">
    <Setter Property="Background" Value="{StaticResource Brush.Warning.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
  </Style>
  <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Foreground}" />
  </Style>
  <Style Selector="Button.warning:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Foreground}" />
  </Style>

  <!-- Ghost: low-emphasis actions in toolbars and headers -->
  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Square icon button -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Width" Value="{StaticResource Size.Control}" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.large">
    <Setter Property="MinHeight" Value="{StaticResource Size.Control.Large}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.large">
    <Setter Property="MinHeight" Value="{StaticResource Size.Control.Large}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
  </Style>
  <!-- Field label: always above its input, wired with Label.Target so screen readers announce it -->
  <Style Selector="Label.field">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <!-- Sections: the side panel is divided into flat sections with a hairline, not floating cards -->
  <Style Selector="Border.section">
    <Setter Property="Padding" Value="{StaticResource Space.Section}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource Brush.Overlay}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Rectangle.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{StaticResource Brush.Border.Subtle}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Badges: short upper-case status words on a tinted background -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Brush.Neutral.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Overline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.badge.success">
    <Setter Property="Background" Value="{StaticResource Brush.Success.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
  </Style>
  <Style Selector="Border.badge.success TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
  </Style>
  <Style Selector="Border.badge.warning">
    <Setter Property="Background" Value="{StaticResource Brush.Warning.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.badge.warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
  </Style>
  <Style Selector="Border.badge.danger TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
  </Style>
  <Style Selector="Border.badge.info">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="Border.badge.info TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
  </Style>
  <Style Selector="Border.badge.accent TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
  </Style>

  <!-- Alerts: inline messages with an icon; the icon and the text carry the meaning, the colour supports it -->
  <Style Selector="Border.alert">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="Border.alert TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="Border.alert ui|StrokeIcon.lead">
    <Setter Property="Foreground" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="Border.alert.danger">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
  </Style>
  <Style Selector="Border.alert.danger ui|StrokeIcon.lead">
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
  </Style>
  <Style Selector="Border.alert.warning">
    <Setter Property="Background" Value="{StaticResource Brush.Warning.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.alert.warning ui|StrokeIcon.lead">
    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.alert.success">
    <Setter Property="Background" Value="{StaticResource Brush.Success.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
  </Style>
  <Style Selector="Border.alert.success ui|StrokeIcon.lead">
    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
  </Style>
  <!-- Navigation rail item: icon over a short label, amber bar on the active page -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent" Height="60" ColumnDefinitions="3,*">
          <Border x:Name="Indicator" Grid.Column="0" CornerRadius="0,2,2,0" Margin="0,10" />
          <Border x:Name="Plate" Grid.Column="1" Margin="6,4,9,4" CornerRadius="{StaticResource Radius.Panel}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#Plate">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.2}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#Plate">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.2}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#Indicator">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
  </Style>
  <Style Selector="RadioButton.nav:focus-visible /template/ Border#Plate">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Row lists (vehicles, mission items): flat rows, blue selection with a left marker -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.2}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
  </Style>

  <!-- CheckBox labels on dark overlays -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <!-- Narrow windows: secondary details step aside rather than being cut in half -->
  <Style Selector="Window.compact StackPanel.optional">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Values that are no longer live (backend connection down) are dimmed, not hidden -->
  <Style Selector="Border.stale">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="ProgressBar.busy">
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="Height" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>
</Styles>
