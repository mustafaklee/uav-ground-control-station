<!--
  Line icons for Controls/StrokeIcon: drawn for this project in a 24 × 24 box, stroked (not filled) with round caps.
  One visual weight everywhere. A dot is a zero-length segment ("M7 7 H7.01"): the round cap makes it a dot.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Brand mark: a hexagonal shield around a delta wing. -->
  <StreamGeometry x:Key="Icon.Brand">M12 2 L20.5 7 V17 L12 22 L3.5 17 V7 Z M12 7 L16.5 15.5 L12 13.4 L7.5 15.5 Z</StreamGeometry>

  <!-- Navigation -->
  <StreamGeometry x:Key="Icon.Flight">M12 2.5 L13.6 9 L21 13 V14.6 L13.6 12.6 L13.1 18 L15.5 19.8 V21 L12 20.1 L8.5 21 V19.8 L10.9 18 L10.4 12.6 L3 14.6 V13 L10.4 9 Z</StreamGeometry>
