<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gcs.Desktop.ViewModels"
        x:Class="Gcs.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="UAV GCS - Sign in"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0F1720">
  <StackPanel Margin="28" Spacing="10">
    <TextBlock Text="UAV GCS" FontWeight="Bold" FontSize="22" Foreground="#E6EDF3" />
    <TextBlock Text="{Binding ServerAddress}" Foreground="#8A9AAB" FontSize="12" />

    <TextBlock Text="Username" Foreground="#8A9AAB" FontSize="12" Margin="0,10,0,0" />
    <TextBox x:Name="UsernameBox" Text="{Binding Username}" />
    <TextBlock Text="Password" Foreground="#8A9AAB" FontSize="12" />
    <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="False" />

    <Button Content="Sign in" Command="{Binding SignInCommand}" IsDefault="True" Classes="accent"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </StackPanel>
</Window>
